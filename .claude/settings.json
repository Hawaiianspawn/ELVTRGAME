{
  "theme": "dark-ansi",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py C:/Projects/ELVTRGAME/Scripts/paca_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "py C:/Projects/ELVTRGAME/Scripts/art/forge_up.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 60,
            "command": "grep -qiE '\"file_path\": *\"[^\"]*godot' && powershell -NoProfile -File C:/Projects/ELVTRGAME/Scripts/godot-run.ps1 >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
