    "prompt": {
      "description": "A veteran of the same line, wearing more of everything. A squared two-step metal helm with a flat crown block above a second flat block, over a wide flared brim with a single dark shadow row beneath it. Large pauldrons rise flush with the jaw so no neck shows at all, and the open face is a narrow slot between brim and shoulders. A plated torso, a heavy belt, a long mail skirt widening the hips, plated greaves and dark boots. The same plain vertical wooden spear as the line soldier.",
      "must_include": [
        "a squared two-step helm - a flat-topped crown block above a second flat-topped block, not a smooth dome",
        "a wide flared brim with exactly one dark shadow row beneath it",
        "pauldrons rising flush with the jaw, no visible neck",
        "an open face reduced to a narrow horizontal slot between brim and pauldrons",
        "a long mail skirt widening the hips below the belt",
        "the same plain wooden spear held dead vertical as the line soldier"
      ],
      "must_avoid": [
        "visor, faceplate or any closed helm - the face must stay open",
        "crest, plume or horsehair",
        "banner, flag, pennant or standard",
        "shield of any shape",
        "horn, trumpet or any curved object",
        "cast shadow, doubled outlines or deep internal recesses between plates",
        "lamp, torch, candle or visible flame",
        "glow, halo, sparks or rays around any pixel",
        "bright or glowing eyes",
        "white or near-white highlights, specular glints",
        "cape or cloak",
        "large solid black body mass, heavy internal outlining"
      ],
      "style_mode": "flat"
    },
