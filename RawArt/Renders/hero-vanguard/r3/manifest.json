  "request_snapshot": {
    "prompt": {
      "description": "A stocky armored standard-bearer in heavy plate. Oversized head in an open-faced helm with no visor and no crest, broad blunt face, squared pauldrons forming a flat horizontal shoulder line, short thick legs. One arm holds a large rectangular tower shield with a flat top edge and a single straight band across its middle; the other grips a straight vertical banner pole at the hip, topped by a small rectangular flag of plain undecorated cloth. A short sword stays sheathed at the hip. Boxy build, hard straight edges, everything squared off.",
      "must_include": [
        "flat horizontal shoulder line, unbroken by collar or cloth",
        "rectangular tower shield with a flat top edge and four straight sides",
        "dead-vertical thin banner pole running down to a hand at hip height",
        "small rectangular flag with four straight edges, clear of the head",
        "open face visible under the helm, no visor"
      ],
      "must_avoid": [
        "cape or cloak",
        "swallowtail, forked, torn or curving flag edges",
        "any device, emblem or writing on the flag",
        "helm crest, plume, wings or horns",
        "lamp, torch, candle or visible flame",
        "glow, halo, sparks or rays around any pixel",
        "bright or glowing eyes",
        "round, kite-shaped or bossed shield",
        "raised, swinging or oversized weapon",
        "tassels, fringe, ragged cloth or straps hanging off the silhouette",
        "diagonal pole or spear-like angle"
      ]
    },
