  "request_snapshot": {
    "prompt": {
      "description": "A destitute volunteer with nothing that was ever issued to them. An oversized head wrapped in a torn cloth rag knotted off to one side, no helmet and no brim, an open face with two sunken eyes. A plain unbelted shirt, thin sloping shoulders, bare wrapped legs and rag-bound feet. Shouldered out to one side at a hard forty-five degree angle, one thick wooden haft, gripped at the chest and stopping short of the top of the head, with a small squared iron cap on its raised end. The haft is stiff timber - dead straight, the same thickness from end to end, like a broom handle. Nothing on this person is armour.",
      "must_include": [
        "torn cloth rag wrapping the head, knotted off to one side - no helmet, no skullcap, no brim",
        "one thick wooden haft on a hard forty-five degree diagonal, dead straight and rigid, the same thickness along its whole length",
        "the haft gripped at the chest and stopping below the top of the head - it never rises past the crown",
        "a small squared iron cap on the raised end of the haft, no wider than the haft itself, the only worked metal on the figure",
        "a plain unbelted shirt and bare wrapped legs, no armour of any kind",
        "narrow sloping shoulders, uneven and soft",
        "two dark sunken eye recesses in an open face"
      ],
      "must_avoid": [
        "helmet, skullcap, brim, visor, crest or plume",
        "any armour plate, pauldron, mail or greaves",
        "spear, polearm or any weapon held vertically",
        "a curved, bent, arced, drooping or flexible haft",
        "a rope, chain, cord, whip, flail or anything that hangs or swings",
        "a haft that tapers, narrows or thins toward either end",
        "an axe head, blade, hammer head, spike cluster or ball on the end of the haft",
        "any held object rising above the top of the head",
        "shield of any shape",
        "banner, flag, pennant or standard",
        "horn, trumpet or any curved object above the head",
        "lamp, torch, candle or visible flame",
        "glow, halo, sparks or rays around any pixel",
        "bright or glowing eyes",
        "white or near-white highlights, specular glints",
        "cape or cloak",
        "large solid black body mass, heavy internal outlining, deep recesses, cast shadow"
      ],
      "style_mode": "flat"
    },
