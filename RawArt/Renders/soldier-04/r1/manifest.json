    "prompt": {
      "description": "A rally caller from the crowd, unarmoured, with a great horn. A large bare shaved skull, no headgear and no brim, an open face with two sunken eyes. A long thick war horn springs from the mouth and sweeps up and away, bending from a diagonal into a near-vertical rise, ending in a wide flared bell with a hard rim well clear of the top of the head. A plain cloth tunic with a single narrow metal strap crossing the chest on a diagonal, a belt, bare legs and dark boots. No weapon at all.",
      "must_include": [
        "a large bare shaved head - no helmet, no headgear, no brim",
        "a long thick war horn attached at the mouth, sweeping up and out from the head",
        "the horn bending from a diagonal into a near-vertical rise, not a straight stick",
        "a wide flared bell with a hard rim, ending well above the top of the head",
        "a single narrow metal strap crossing the chest on a diagonal",
        "no weapon of any kind"
      ],
      "must_avoid": [
        "helmet, skullcap, brim, visor, crest or plume",
        "banner, flag, pennant, standard or any cloth rectangle",
        "spear, sword, club, shield or any weapon",
        "a straight horn or a straight tube - it must bend",
        "a horn held in the hand away from the face",
        "lamp, torch, candle or visible flame",
        "glow, halo, sparks or rays around any pixel",
        "bright or glowing eyes",
        "white or near-white highlights, specular glints",
        "cape or cloak",
        "large solid black body mass, heavy internal outlining, deep recesses, cast shadow"
      ],
      "style_mode": "flat"
    },
