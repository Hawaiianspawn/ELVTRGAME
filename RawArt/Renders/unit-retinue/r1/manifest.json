  "request_snapshot": {
    "prompt": {
      "description": "A ragged militia footman in mismatched scavenged gear, stocky and small-limbed with an oversized head. A battered metal skullcap sits low over one side of the head; the other side is bare scalp and an open face. One shoulder carries a bulky salvaged pauldron and armoured sleeve; the opposite arm is thin, bare and wrapped in bandages. The chest is half patched cloth jerkin, half a single scavenged breastplate. One leg is booted, the other bare and wrapped. Held low and angled away from the body, an improvised wooden club with an iron-bound head. Nothing matches.",
      "must_include": [
        "uneven shoulder line - one bulky pauldron sitting higher, one thin bandaged arm sitting lower",
        "skullcap covering only one side of the head, bare scalp and open face on the other",
        "torso split down the middle, patched cloth on one side and a single scavenged plate on the other",
        "one booted leg and one bare wrapped leg",
        "improvised club held at an off-vertical angle, its far end clear of the body outline",
        "two dark eye recesses in an open face"
      ],
      "must_avoid": [
        "matched or uniform armour",
        "closed helmet, visor, faceplate, crest or plume",
        "symmetrical shoulders or a flat level shoulder line",
        "banner, flag, pennant or standard",
        "rectangular, round or kite shield",
        "spear, polearm or any weapon held vertically",
        "lamp, torch, candle or visible flame",
        "glow, halo, sparks or rays around any pixel",
        "bright or glowing eyes",
        "white or near-white highlights, specular glints",
        "cape or cloak",
        "large solid black body mass, heavy internal outlining, deep recesses, cast shadow"
      ]
    },
